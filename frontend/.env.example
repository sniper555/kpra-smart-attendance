# Leave empty on this computer. The Next server proxies /api to the local API.
# On Netlify, set this to the Render API origin with no trailing slash.
# Example: https://kpra-attendance-api.onrender.com
NEXT_PUBLIC_API_URL=

# Used only by next dev / next start on this computer.
API_PROXY_TARGET=http://127.0.0.1:8010
