# Copy to .env locally. Never commit .env.
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_STRING_AT_LEAST_32_CHARS
DATABASE_URL=postgresql+psycopg://attendance:CHANGE_ME@db:5432/attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=attendance
FRONTEND_ORIGIN=http://127.0.0.1:8080
# Extra browser origins, comma-separated. ALLOWED_ORIGINS is the same list.
# Local phone app: http://localhost:3410
# Public site: https://kpra-attendance.netlify.app
FRONTEND_ORIGINS=
ALLOWED_ORIGINS=
TIMEZONE=Asia/Karachi
MFA_ISSUER=KPRA Smart Attendance Lite
COOKIE_SECURE=false
# Use "none" only on HTTPS when the site and the API are different hosts.
# Localhost must stay "lax".
COOKIE_SAMESITE=lax
TRUST_PROXY=true
SESSION_HOURS=12

# First boot only. Unset these after the administrator account exists.
BOOTSTRAP_ADMIN_EMAIL=admin@kpra.example
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME=Local Administrator

# Development-only test manager. Refused when APP_ENV=production.
SEED_DEV_DATA=true
SEED_MANAGER_EMAIL=manager@kpra.example
SEED_MANAGER_PASSWORD=CHANGE_ME_MANAGER_PASSWORD
SEED_MANAGER_NAME=Test Manager

# Leave disabled. Turning these on does not start a protocol client;
# the worker records a misconfiguration and sends nothing.
# BASE_URL and API_TOKEN are ignored until a written TimeNex contract exists.
TIMENEX_INTEGRATION_ENABLED=false
TIMENEX_WRITE_MODE=none
TIMENEX_BASE_URL=
TIMENEX_API_TOKEN=
TIMENEX_PORTAL_URL=https://www.timenex.net:8443
TIMENEX_USERNAME=
TIMENEX_PASSWORD=
TIMENEX_PORTAL_ENABLED=false

SENSEFACE_ADMS_ENABLED=false
SENSEFACE_ADMS_LISTEN_PORT=
